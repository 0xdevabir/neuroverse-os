# neuroverse-os.pc.in
#
# pkg-config metadata for the NeuroVerse OS host library.
# Generated by the Makefile at install time; the @VARS@ are
# substituted then. Version values are kept in lockstep with
# include/neuro/core/version.hpp and meson.build — the CI release
# gate (Phase P4.2) verifies all three sources agree.

prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: NeuroVerse OS
Description: Self-evolving capability-secure microkernel (host scaffold).
URL: https://github.com/neuroverse/neuroverse-os
Version: @VERSION@
Requires:
Libs: -L${libdir} -lneuro_host
Cflags: -I${includedir}
